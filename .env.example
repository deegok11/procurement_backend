# Copy to .env (or export these directly) before running setup.sh
GEMINI_API_KEY=AIza...
JWT_SECRET=dev-only-change-me
TOKEN_TTL_MINUTES=60
CHAT_MODEL=gemini-3.6-flash
# EXTRACTION_MODEL can be a stronger (preview) model for document accuracy, e.g. gemini-3.1-pro-preview
EXTRACTION_MODEL=gemini-3.6-flash
# GUARDRAIL_MODEL is deliberately cheaper than CHAT_MODEL/EXTRACTION_MODEL — it's a
# simple in/out-of-scope classification that runs on every chat turn, not open-ended
# reasoning or extraction
GUARDRAIL_MODEL=gemini-3.5-flash-lite
FISCAL_YEAR_START_MONTH=4
APPROVAL_TOLERANCE_PCT=2
DATA_DIR=./data
UPLOAD_DIR=./app/uploads
PORT=8000
